# =========================
# VPN Panel (FastAPI)
# =========================
PANEL_BIND_IP=127.0.0.1
PANEL_PORT=18081
REAL_DEPLOY_ENABLED=1
DEFAULT_REALITY_SNI=www.cloudflare.com
METRICS_POLL_INTERVAL=15
SUBS_SYNC_INTERVAL=30

# Admin auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_strong_password
ADMIN_SESSION_TTL=86400
ADMIN_COOKIE_SECURE=0

# Branding / Happ metadata
VPN_BRAND_NAME=BURMALDAA VPN
HAPP_SUPPORT_URL=https://example.com/support
HAPP_RENEW_URL=https://example.com/pay
HAPP_SUB_INFO_TEXT=Support: @your_tg
HAPP_PROFILE_UPDATE_INTERVAL=1

# Device / promo
DEFAULT_DEVICE_LIMIT=2
PROMO_TELEGRAM_NAME=Наш Telegram
PROMO_TELEGRAM_URL=https://t.me/your_channel
PROMO_SITE_NAME=Наш сайт
PROMO_SITE_URL=https://your-site.example

# Bot security (used by backend /api/bot/issue-key)
BOT_API_TOKEN=replace_with_random_secret
BOT_SUB_DAYS=7
BOT_SUB_COOLDOWN_DAYS=7
BOT_SUB_TRAFFIC_GB=50
BOT_SUB_DEVICE_LIMIT=1

# =========================
# Telegram bot (optional)
# Run with: docker compose --profile bot up -d --build
# =========================
TG_BOT_TOKEN=
TG_CHANNEL=@your_channel
TG_CHANNEL_URL=https://t.me/your_channel
PANEL_BASE_URL=http://vpn-panel:18081
PUBLIC_BASE_URL=https://your-domain.example/vpn/panel
